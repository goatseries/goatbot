SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_123456789
KLAVIYO_API_KEY=
# Optional, later
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Behavior
REPORT_TZ=America/New_York
SCOREBOARD_TIMES=09:00,18:00
POLL_SECONDS=10
COGS_CSV_PATH=cogs.csv
COSTS_DAYS=90
SHOPIFY_FEE_PCT=2.9
SHOPIFY_FEE_FIXED=0.30
DEFAULT_SHIPPING_COST=0
DRY_RUN=1
